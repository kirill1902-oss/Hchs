--// ============================================================
RunService.RenderStepped:Connect(function()
    local showFOV = State.Aim or State.Trigger or State.AimAssist
    if FOVCircle.Visible ~= showFOV then FOVCircle.Visible = showFOV end
    if showFOV then
        FOVCircle.Position = Camera.ViewportSize * 0.5
        FOVCircle.Radius   = State.FOV
    end

    -- Хитбокс (динамически для новых персонажей)
    if State.Hitbox then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local char = p.Character
                if char and not HitboxCache[char] then
                    applyHitboxToCharacter(char)
                end
            end
        end
    end

    local aimed = false

    -- АИМБОТ ВСЕХ (приоритет)
    if State.AimAssist then
        local target, part = findClosestAll()
        if target and part then
            aimed = true
            if Camera.CameraType ~= Enum.CameraType.Custom then
                Camera.CameraType = Enum.CameraType.Custom
            end
            local camPos = Camera.CFrame.Position
            if (camPos - part.Position).Magnitude > 0.5 then
                Camera.CFrame = CFrame.lookAt(camPos, part.Position)
            end
            local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen and mousemoveabs then
                pcall(function() mousemoveabs(sp.X, sp.Y) end)
            end
        end
    end

    -- АИМБОТ ВРАГИ + ТРИГГЕР
    if not aimed and (State.Aim or State.Trigger) then
        local target, part = findClosestEnemy()
        if target and part then
            aimed = true

            if State.Aim then
                if Camera.CameraType ~= Enum.CameraType.Custom then
                    Camera.CameraType = Enum.CameraType.Custom
                end
                local camPos = Camera.CFrame.Position
                if (camPos - part.Position).Magnitude > 0.5 then
                    local goal = CFrame.lookAt(camPos, part.Position)
                    Camera.CFrame = Camera.CFrame:Lerp(goal, AIM_SPEED)
                end
            end

            if State.Trigger and os.clock() - lastTrigger > TriggerCooldown then
                lastTrigger = os.clock()

                local char = LocalPlayer.Character
                local tool = char and char:FindFirstChildOfClass("Tool")
                if tool then
                    local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        if mousemoveabs then
                            pcall(function() mousemoveabs(sp.X, sp.Y) end)
                        end
                        pcall(function()
                            VirtualUser:Button1Down(Vector2.new(sp.X, sp.Y))
                            task.wait(0.02)
                            VirtualUser:Button1Up(Vector2.new(sp.X, sp.Y))
                        end)
                    end
                end
            end
        end
    end

    -- Обновление бейджа команды
    if LastTeamName ~= (LocalPlayer.Team and LocalPlayer.Team.Name) then
        LastTeamName = LocalPlayer.Team and LocalPlayer.Team.Name
        updateTeamBadge()
    end
end)

