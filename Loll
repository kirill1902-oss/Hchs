-- Возвращает "Guard", "Criminal", "Inmate", "Neutral"
local function getTeamKind(player)
    local t = player.Team
    if not t then return "Neutral" end
    local n = string.lower(t.Name)

    -- Полиция / Охрана
    if n:find("guard") or n:find("police") or n:find("warden")
    or n:find("cop") or n:find("officer") or n:find("sheriff")
    or n:find("охрана") or n:find("полиц") then
        return "Guard"
    end

    -- Сбежавшие / Преступники
    if n:find("crim") or n:find("escape") or n:find("fugitive")
    or n:find("сбеж") or n:find("преступ") then
        return "Criminal"
    end

    -- Заключённые
    if n:find("inmate") or n:find("prisoner") or n:find("convict")
    or n:find("заключ") or n:find("зек") then
        return "Inmate"
    end

    return "Neutral"
end

--// ЛОГИКА ЦЕЛЕЙ ДЛЯ АИМБОТА "ВРАГИ"
-- Если я ПОЛИЦЕЙСКИЙ (Guard)    -> цель только СБЕЖАВШИЕ (Criminal)
-- Если я СБЕЖАВШИЙ (Criminal)   -> цель только ПОЛИЦЕЙСКИЕ (Guard)
-- Если я ЗАКЛЮЧЁННЫЙ (Inmate)   -> цель ПОЛИЦЕЙСКИЕ (Guard) [на всякий]
-- Если я NEUTRAL                -> цель все, кроме своей команды
local function isAimTarget(player)
    if player == LocalPlayer then return false end
    if not player.Character then return false end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    local my  = getTeamKind(LocalPlayer)
    local his = getTeamKind(player)

    -- Нет команды у меня — бьём всех чужих
    if my == "Neutral" then
        return his ~= "Neutral" or player.Team ~= LocalPlayer.Team
    end

    -- Я ПОЛИЦЕЙСКИЙ -> цель только СБЕЖАВШИЕ
    if my == "Guard" then
        return his == "Criminal"
    end

    -- Я СБЕЖАВШИЙ -> цель только ПОЛИЦЕЙСКИЕ
    if my == "Criminal" then
        return his == "Guard"
    end

    -- Я ЗАКЛЮЧЁННЫЙ -> цель ПОЛИЦЕЙСКИЕ и СБЕЖАВШИЕ
    if my == "Inmate" then
        return his == "Guard" or his == "Criminal"
    end

    -- По умолчанию — все, кроме своей команды
    return player.Team ~= LocalPlayer.Team
end

local function isFactionEnemy(player) return isAimTarget(player) end

