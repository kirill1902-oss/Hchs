--// ============================================================
local function resetHitboxOnCharacter(char)
    if not char then return end
    local list = HitboxCache[char]
    if list then
        for _, entry in ipairs(list) do
            if entry.conn then entry.conn:Disconnect() end
            if entry.hb and entry.hb.Parent then entry.hb:Destroy() end
        end
        HitboxCache[char] = nil
    end
    for _, part in ipairs(char:GetDescendants()) do
        if part.Name == "PL_Hitbox" then part:Destroy() end
    end
end

local function applyHitboxToCharacter(char)
    if not char then return end
    if HitboxCache[char] then return end
    local list = {}
    for partName in pairs(HitboxParts) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            if part:FindFirstChild("PL_Hitbox") then continue end
            local hb = Instance.new("Part")
            hb.Name = "PL_Hitbox"
            hb.Size = part.Size * HITBOX_SCALE
            hb.Transparency = 0.75
            hb.Color = Color3.fromRGB(255, 130, 180)
            hb.Material = Enum.Material.Neon
            hb.CanCollide = false
            hb.CanTouch = true
            hb.CanQuery = true
            hb.Massless = true
            hb.Anchored = false
            hb.CastShadow = false
            hb.Parent = part
            local weld = Instance.new("Weld")
            weld.Name = "PL_HitboxWeld"
            weld.Part0 = part
            weld.Part1 = hb
            weld.C0 = CFrame.new()
            weld.Parent = hb
            local conn
            conn = part:GetPropertyChangedSignal("Size"):Connect(function()
                if hb and hb.Parent then hb.Size = part.Size * HITBOX_SCALE end
            end)
            table.insert(list, {hb = hb, conn = conn})
        end
    end
    HitboxCache[char] = list
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.Died:Connect(function() resetHitboxOnCharacter(char) end) end
end

local function enableHitboxAll()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then applyHitboxToCharacter(p.Character) end
    end
end

local function disableHitboxAll()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then resetHitboxOnCharacter(p.Character) end
    end
end

local function watchCharForHitbox(player)
    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        if State.Hitbox then applyHitboxToCharacter(char) end
    end)
    player.CharacterRemoving:Connect(function(char)
        resetHitboxOnCharacter(char)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then watchCharForHitbox(p) end
end
Players.PlayerAdded:Connect(function(p)
    if p ~= LocalPlayer then watchCharForHitbox(p) end
