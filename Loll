    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = Theme.Stroke
    stroke.Thickness = 1

    local indicator = Instance.new("Frame")
    indicator.BackgroundColor3 = Theme.Accent
    indicator.BorderSizePixel = 0
    indicator.Position = UDim2.new(0.5, -14, 0, 6)
    indicator.Size = UDim2.new(0, 28, 0, 3)
    indicator.Parent = btn
    Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 4, 0, 16)
    label.Size = UDim2.new(1, -8, 0, 40)
    label.Font = Enum.Font.GothamMedium
    label.Text = text
    label.TextColor3 = Theme.Text
    label.TextSize = 10
    label.TextWrapped = true
    label.Parent = btn

    local stateBadge = Instance.new("TextLabel")
    stateBadge.BackgroundColor3 = Color3.fromRGB(55, 30, 55)
    stateBadge.BorderSizePixel = 0
    stateBadge.Position = UDim2.new(0.5, -20, 1, -22)
    stateBadge.Size = UDim2.new(0, 40, 0, 18)
    stateBadge.Font = Enum.Font.GothamBold
    stateBadge.Text = "OFF"
    stateBadge.TextColor3 = Theme.TextDim
    stateBadge.TextSize = 10
    stateBadge.Parent = btn
    Instance.new("UICorner", stateBadge).CornerRadius = UDim.new(0, 4)

    btn.MouseEnter:Connect(function()
        local key = btn:GetAttribute("Key")
        if not (key and State[key]) then
            btn.BackgroundColor3 = Color3.fromRGB(50, 25, 50)
            stroke.Color = Theme.AccentDark
        end
    end)
    btn.MouseLeave:Connect(function()
        local key = btn:GetAttribute("Key")
        if not (key and State[key]) then
            btn.BackgroundColor3 = Theme.BgAlt
            stroke.Color = Theme.Stroke
        end
    end)

    return btn, indicator, label, stateBadge, stroke
end

local function buildFOVSlider()
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 10, 0, 6)
    lbl.Size = UDim2.new(0, 100, 0, 14)
    lbl.Font = Enum.Font.GothamMedium
    lbl.Text = "FOV: " .. State.FOV
    lbl.TextColor3 = Theme.TextDim
