local function updateButtonVisual(key, indicator, label, badge, stroke, baseText)
    local on = State[key]
    if on then
        indicator.BackgroundColor3 = Theme.Green
        badge.BackgroundColor3 = Theme.GreenDark
        badge.TextColor3 = Theme.Text
        badge.Text = "ON"
        stroke.Color = Theme.Green
    else
        indicator.BackgroundColor3 = Theme.Accent
        badge.BackgroundColor3 = Color3.fromRGB(55, 30, 55)
        badge.TextColor3 = Theme.TextDim
        badge.Text = "OFF"
        stroke.Color = Theme.Stroke
    end
    label.Text = baseText
end

local function bindToggle(btn, key, text, indicator, label, badge, stroke)
    btn:SetAttribute("Key", key)
    btn.MouseButton1Click:Connect(function()
        State[key] = not State[key]
        updateButtonVisual(key, indicator, label, badge, stroke, text)

        if not State[key] then
            if key == "Hitbox" then
                disableHitboxAll()
            elseif key == "ESP" then
                for _, bb in pairs(ESPCache) do bb.Enabled = false end
            end
        elseif key == "Hitbox" then
            enableHitboxAll()
        elseif key == "ESP" then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then refreshESP(p) end
            end
        end
    end)
end

